{
  "info": {
    "_postman_id": "9f1e2f3b-1111-4a5b-8c2d-640000000001",
    "name": "Zero Trust Sistem Nilai — <Auth, Nilai/Kelas, Anti-lompat-pintu>",
    "description": "Koleksi uji API Sistem Nilai Zero Trust.\n\nPrasyarat:\n1. Jalankan ketiga aplikasi (npm run gateway / service:nilai / service:transkrip).\n2. Isi collection variable `serviceClientSecret` dan `gatewaySecret` dengan nilai dari .env AKTIF (lihat README).\n3. Untuk skenario finalisasi sukses, default jam akses 07:00-21:00 (Asia/Jakarta). Koleksi 'luar jam' ada di file terpisah.\n\nVariabel dinamis (accessTokenDosen1, nilaiId..., dll.) diisi otomatis oleh test script — pastikan request dijalankan berurutan dalam folder.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "gatewayUrl", "value": "http://localhost:3000" },
    { "key": "serviceNilaiUrl", "value": "http://localhost:3001" },
    { "key": "serviceTranskripUrl", "value": "http://localhost:3002" },
    { "key": "deviceAdmin", "value": "DEV-ADMIN-01" },
    { "key": "deviceDosen1", "value": "DEV-DOSEN-01" },
    { "key": "deviceDosen2", "value": "DEV-DOSEN-02" },
    { "key": "deviceMhs1", "value": "DEV-MHS-01" },
    { "key": "deviceMhs2", "value": "DEV-MHS-02" },
    { "key": "dosenUser1", "value": "budi.santoso" },
    { "key": "dosenUser2", "value": "siti.rahayu" },
    { "key": "dosenPass", "value": "Dosen#12345" },
    { "key": "adminUser", "value": "admin" },
    { "key": "adminPass", "value": "Admin#12345" },
    { "key": "nimAndi", "value": "10522001" },
    { "key": "nimBela", "value": "10522002" },
    { "key": "nimCahyo", "value": "10522003" },
    { "key": "mhsPass", "value": "Mhs#12345" },
    { "key": "serviceClientId", "value": "nilai-service" },
    { "key": "serviceClientSecret", "value": "ISI-DARI-ENV-LOKAL" },
    { "key": "gatewaySecret", "value": "ISI-DARI-ENV-LOKAL" },
    { "key": "accessTokenDosen1", "value": "" },
    { "key": "refreshTokenDosen1", "value": "" },
    { "key": "rtOldDosen1", "value": "" },
    { "key": "accessTokenDosen2", "value": "" },
