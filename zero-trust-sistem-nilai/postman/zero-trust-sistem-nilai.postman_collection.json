  ],
  "item": [
    {
      "name": "A. Autentikasi",
      "item": [
        {
          "name": "A1  Login dosen (200, simpan token)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Device-ID", "value": "{{deviceDosen1}}" }
            ],
            "url": { "raw": "{{gatewayUrl}}/auth/login", "host": ["{{gatewayUrl}}"], "path": ["auth", "login"] },
            "body": { "mode": "raw", "raw": "{\"username\":\"{{dosenUser1}}\",\"password\":\"{{dosenPass}}\"}" }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test('TTL access token 600 detik', () => pm.expect(b.expiresIn).to.eql(600));",
              "pm.collectionVariables.set('accessTokenDosen1', b.accessToken);",
              "pm.collectionVariables.set('refreshTokenDosen1', b.refreshToken);"
            ] } }
          ]
        },
        {
          "name": "A2  Login mahasiswa (200, simpan token)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Device-ID", "value": "{{deviceMhs1}}" }
            ],
            "url": { "raw": "{{gatewayUrl}}/auth/login", "host": ["{{gatewayUrl}}"], "path": ["auth", "login"] },
            "body": { "mode": "raw", "raw": "{\"username\":\"{{nimAndi}}\",\"password\":\"{{mhsPass}}\"}" }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.collectionVariables.set('accessTokenMhs1', b.accessToken);"
            ] } }
          ]
        },
        {
          "name": "A3  Login admin (200, simpan token)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Device-ID", "value": "{{deviceAdmin}}" }
            ],
            "url": { "raw": "{{gatewayUrl}}/auth/login", "host": ["{{gatewayUrl}}"], "path": ["auth", "login"] },
            "body": { "mode": "raw", "raw": "{\"username\":\"{{adminUser}}\",\"password\":\"{{adminPass}}\"}" }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('accessTokenAdmin', pm.response.json().accessToken);"
            ] } }
          ]
        },
        {
          "name": "A3b  Login dosen2 (200, simpan token)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Device-ID", "value": "{{deviceDosen2}}" }
            ],
            "url": { "raw": "{{gatewayUrl}}/auth/login", "host": ["{{gatewayUrl}}"], "path": ["auth", "login"] },
            "body": { "mode": "raw", "raw": "{\"username\":\"{{dosenUser2}}\",\"password\":\"{{dosenPass}}\"}" }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('accessTokenDosen2', pm.response.json().accessToken);"
            ] } }
          ]
        },
        {
          "name": "A4  Login password salah (401)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Device-ID", "value": "{{deviceDosen1}}" }
            ],
            "url": { "raw": "{{gatewayUrl}}/auth/login", "host": ["{{gatewayUrl}}"], "path": ["auth", "login"] },
            "body": { "mode": "raw", "raw": "{\"username\":\"{{dosenUser1}}\",\"password\":\"benar-tapi-salah\"}" }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));",
              "pm.test('code CREDENTIALS_INVALID', () => { const e = pm.response.json().error; pm.expect(e).to.have.property('code', 'CREDENTIALS_INVALID'); });"
            ] } }
          ]
        },
        {
          "name": "A5  Login device milik user lain (403)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Device-ID", "value": "{{deviceMhs1}}" }
            ],
            "url": { "raw": "{{gatewayUrl}}/auth/login", "host": ["{{gatewayUrl}}"], "path": ["auth", "login"] },
            "body": { "mode": "raw", "raw": "{\"username\":\"{{dosenUser1}}\",\"password\":\"{{dosenPass}}\"}" }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('HTTP 403', () => pm.response.to.have.status(403));",
              "pm.test('code DEVICE_NOT_REGISTERED', () => { pm.expect(pm.response.json().error).to.have.property('code', 'DEVICE_NOT_REGISTERED'); });"
            ] } }
          ]
        },
        {
          "name": "A6  Refresh valid (200, rotasi single-use)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Device-ID", "value": "{{deviceDosen1}}" }
            ],
            "url": { "raw": "{{gatewayUrl}}/auth/refresh", "host": ["{{gatewayUrl}}"], "path": ["auth", "refresh"] },
            "body": { "mode": "raw", "raw": "{\"refreshToken\":\"{{refreshTokenDosen1}}\"}" }
          },
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
              "pm.collectionVariables.set('rtOldDosen1', pm.collectionVariables.get('refreshTokenDosen1'));"
            ] } },
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test('refresh token baru berbeda dari lama', () => pm.expect(b.refreshToken).to.not.eql(pm.collectionVariables.get('rtOldDosen1')));",
              "pm.collectionVariables.set('refreshTokenDosen1', b.refreshToken);"
            ] } }
          ]
        },
        {
          "name": "A7  Refresh dengan token lama yang sudah putar (401 REVOKED)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Device-ID", "value": "{{deviceDosen1}}" }
            ],
            "url": { "raw": "{{gatewayUrl}}/auth/refresh", "host": ["{{gatewayUrl}}"], "path": ["auth", "refresh"] },
            "body": { "mode": "raw", "raw": "{\"refreshToken\":\"{{rtOldDosen1}}\"}" }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));",
              "pm.test('code REFRESH_TOKEN_REVOKED', () => { pm.expect(pm.response.json().error).to.have.property('code', 'REFRESH_TOKEN_REVOKED'); });"
            ] } }
          ]
        },
        {
          "name": "A8  Logout (200, refresh token dicabut)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Device-ID", "value": "{{deviceDosen1}}" }
            ],
            "url": { "raw": "{{gatewayUrl}}/auth/logout", "host": ["{{gatewayUrl}}"], "path": ["auth", "logout"] },
            "body": { "mode": "raw", "raw": "{\"refreshToken\":\"{{refreshTokenDosen1}}\"}" }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('pesan logout', () => { pm.expect(pm.response.json().message).to.include('dicabut'); });"
            ] } }
          ]
        },
        {
          "name": "A9  Refresh setelah logout (401)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Device-ID", "value": "{{deviceDosen1}}" }
            ],
            "url": { "raw": "{{gatewayUrl}}/auth/refresh", "host": ["{{gatewayUrl}}"], "path": ["auth", "refresh"] },
            "body": { "mode": "raw", "raw": "{\"refreshToken\":\"{{refreshTokenDosen1}}\"}" }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));",
              "pm.test('code REFRESH_TOKEN_REVOKED', () => { pm.expect(pm.response.json().error).to.have.property('code', 'REFRESH_TOKEN_REVOKED'); });"
            ] } }
          ]
        },
        {
          "name": "A10  /auth/service valid (200, TTL 300)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{gatewayUrl}}/auth/service", "host": ["{{gatewayUrl}}"], "path": ["auth", "service"] },
            "body": { "mode": "raw", "raw": "{\"clientId\":\"{{serviceClientId}}\",\"clientSecret\":\"{{serviceClientSecret}}\"}" }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test('TTL token service 300 detik', () => pm.expect(b.expiresIn).to.eql(300));",
              "pm.collectionVariables.set('serviceToken', b.accessToken);"
            ] } }
          ]
        },
        {
          "name": "A11  /auth/service kredensial salah (401)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{gatewayUrl}}/auth/service", "host": ["{{gatewayUrl}}"], "path": ["auth", "service"] },
            "body": { "mode": "raw", "raw": "{\"clientId\":\"nilai-service\",\"clientSecret\":\"salah-total\"}" }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));",
              "pm.test('code CLIENT_INVALID', () => { pm.expect(pm.response.json().error).to.have.property('code', 'CLIENT_INVALID'); });"
            ] } }
          ]
        }
      ]
    },
    {
      "name": "B. Nilai & Kelas via gateway",
      "item": [
        {
          "name": "B1  Dosen1 GET /nilai — capture KIF-101 id",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessTokenDosen1}}" },
              { "key": "X-Device-ID", "value": "{{deviceDosen1}}" }
            ],
            "url": { "raw": "{{gatewayUrl}}/nilai", "host": ["{{gatewayUrl}}"], "path": ["nilai"] }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test('dosen hanya lihat KIF-101', () => pm.expect(b.kelas).to.have.lengthOf(1));",
              "pm.collectionVariables.set('kelasIdKif101', String(b.kelas[0].kelas.id));",
              "const andi = b.kelas[0].peserta.find(p => p.nim === pm.collectionVariables.get('nimAndi'));",
              "pm.collectionVariables.set('nilaiIdKif101Andi', String(andi.nilai_id));"
            ] } }
          ]
        },
        {
          "name": "B2  Dosen2 GET /nilai — capture KIF-102 id",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessTokenDosen2}}" },
              { "key": "X-Device-ID", "value": "{{deviceDosen2}}" }
            ],
            "url": { "raw": "{{gatewayUrl}}/nilai", "host": ["{{gatewayUrl}}"], "path": ["nilai"] }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const k = pm.response.json().kelas[0];",
              "pm.collectionVariables.set('kelasIdKif102', String(k.kelas.id));",
              "const andi = k.peserta.find(p => p.nim === pm.collectionVariables.get('nimAndi'));",
              "pm.test('nilai Andi di KIF-102 sudah final di seed', () => pm.expect(andi.final).to.eql(true));",
              "pm.collectionVariables.set('nilaiIdKif102Final', String(andi.nilai_id));",
              "const cahyo = k.peserta.find(p => p.nim === pm.collectionVariables.get('nimCahyo'));",
              "pm.test('Cahyo belum dinilai (seed)', () => pm.expect(cahyo.nilai_id).to.eql(null));",
              "pm.collectionVariables.set('enrollIdKif102Cahyo', String(cahyo.enroll_id));"
            ] } }
          ]
        },
        {
          "name": "B3  Mahasiswa GET /nilai (200)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessTokenMhs1}}" },
              { "key": "X-Device-ID", "value": "{{deviceMhs1}}" }
            ],
            "url": { "raw": "{{gatewayUrl}}/nilai", "host": ["{{gatewayUrl}}"], "path": ["nilai"] }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('mahasiswa melihat 2 baris nilai', () => pm.expect(pm.response.json().nilai).to.have.lengthOf(2));"
            ] } }
          ]
        },
        {
          "name": "B4  Mahasiswa GET transkrip sendiri (200)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessTokenMhs1}}" },
              { "key": "X-Device-ID", "value": "{{deviceMhs1}}" }
            ],
            "url": { "raw": "{{gatewayUrl}}/transkrip/{{nimAndi}}", "host": ["{{gatewayUrl}}"], "path": ["transkrip", "{{nimAndi}}"] }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('transkrip adalah array', () => pm.expect(Array.isArray(pm.response.json().transkrip)).to.eql(true));"
            ] } }
          ]
        },
        {
          "name": "B5  Mahasiswa GET transkrip NIM lain (403)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessTokenMhs1}}" },
              { "key": "X-Device-ID", "value": "{{deviceMhs1}}" }
            ],
            "url": { "raw": "{{gatewayUrl}}/transkrip/{{nimBela}}", "host": ["{{gatewayUrl}}"], "path": ["transkrip", "{{nimBela}}"] }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('HTTP 403', () => pm.response.to.have.status(403));",
              "pm.test('code FORBIDDEN_OWNERSHIP', () => { pm.expect(pm.response.json().error).to.have.property('code', 'FORBIDDEN_OWNERSHIP'); });"
            ] } }
          ]
        },
        {
          "name": "B6  Admin GET transkrip mahasiswa mana pun (200)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessTokenAdmin}}" },
              { "key": "X-Device-ID", "value": "{{deviceAdmin}}" }
            ],
            "url": { "raw": "{{gatewayUrl}}/transkrip/{{nimAndi}}", "host": ["{{gatewayUrl}}"], "path": ["transkrip", "{{nimAndi}}"] }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ] } }
          ]
        },
        {
          "name": "B7  Dosen1 PUT nilai Andi 95 (200)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessTokenDosen1}}" },
              { "key": "X-Device-ID", "value": "{{deviceDosen1}}" }
            ],
            "url": { "raw": "{{gatewayUrl}}/nilai/{{nilaiIdKif101Andi}}", "host": ["{{gatewayUrl}}"], "path": ["nilai", "{{nilaiIdKif101Andi}}"] },
            "body": { "mode": "raw", "raw": "{\"nilai\": 95}" }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('nilai tersimpan 95', () => pm.expect(pm.response.json().nilai).to.eql(95));"
            ] } }
          ]
        },
        {
          "name": "B8  Mahasiswa PUT nilai (403)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessTokenMhs1}}" },
              { "key": "X-Device-ID", "value": "{{deviceMhs1}}" }
            ],
            "url": { "raw": "{{gatewayUrl}}/nilai/{{nilaiIdKif101Andi}}", "host": ["{{gatewayUrl}}"], "path": ["nilai", "{{nilaiIdKif101Andi}}"] },
            "body": { "mode": "raw", "raw": "{\"nilai\": 1}" }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('HTTP 403', () => pm.response.to.have.status(403));",
              "pm.test('code FORBIDDEN_ROLE', () => { pm.expect(pm.response.json().error).to.have.property('code', 'FORBIDDEN_ROLE'); });"
            ] } }
          ]
        },
        {
          "name": "B9  Dosen1 PUT nilai kelas dosen lain (403 OWNERSHIP)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessTokenDosen1}}" },
              { "key": "X-Device-ID", "value": "{{deviceDosen1}}" }
            ],
            "url": { "raw": "{{gatewayUrl}}/nilai/{{nilaiIdKif102Final}}", "host": ["{{gatewayUrl}}"], "path": ["nilai", "{{nilaiIdKif102Final}}"] },
            "body": { "mode": "raw", "raw": "{\"nilai\": 1}" }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('HTTP 403', () => pm.response.to.have.status(403));",
              "pm.test('code FORBIDDEN_OWNERSHIP', () => { pm.expect(pm.response.json().error).to.have.property('code', 'FORBIDDEN_OWNERSHIP'); });"
            ] } }
          ]
        },
        {
          "name": "B10  Dosen2 PUT nilai yang sudah final (403)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessTokenDosen2}}" },
              { "key": "X-Device-ID", "value": "{{deviceDosen2}}" }
            ],
            "url": { "raw": "{{gatewayUrl}}/nilai/{{nilaiIdKif102Final}}", "host": ["{{gatewayUrl}}"], "path": ["nilai", "{{nilaiIdKif102Final}}"] },
            "body": { "mode": "raw", "raw": "{\"nilai\": 77}" }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('HTTP 403', () => pm.response.to.have.status(403));",
              "pm.test('code ALREADY_FINAL', () => { pm.expect(pm.response.json().error).to.have.property('code', 'ALREADY_FINAL'); });"
            ] } }
          ]
        },
        {
          "name": "B11  PUT nilai 999 (400)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
