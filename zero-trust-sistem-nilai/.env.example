# ============================================================
# Konfigurasi Zero Trust Sistem Nilai
# Salin file ini menjadi .env lalu isi nilai aslinya.
# JANGAN commit file .env ke repository.
# ============================================================

# ---- Gateway (port 3000) ----
GATEWAY_PORT=3000

# Secret yang dibagikan gateway -> service (wajib kuat)
GATEWAY_SECRET=ganti-dengan-secret-acak-minimal-32-karakter

# Secret untuk sign/verify JWT user & service
JWT_SECRET=ganti-dengan-secret-jwt-acak

# ---- Service Nilai (port 3001) ----
SERVICE_NILAI_PORT=3001
SERVICE_NILAI_URL=http://localhost:3001

# ---- Service Transkrip (port 3002) ----
SERVICE_TRANSKRIP_PORT=3002
SERVICE_TRANSKRIP_URL=http://localhost:3002

# ---- Client credentials untuk token service (role: service) ----
# Dipakai Service Nilai untuk POST /auth/service
SERVICE_CLIENT_ID=nilai-service
SERVICE_CLIENT_SECRET=ganti-dengan-secret-client-service

# ---- Masa berlaku token (detik) ----
ACCESS_TOKEN_TTL=600
REFRESH_TOKEN_TTL=86400
SERVICE_TOKEN_TTL=300

# ---- Jam akses (perubahan/finalisasi nilai) ----
# Format 24 jam; zona waktu dari TIMEZONE (IANA)
ACCESS_START_HOUR=7
ACCESS_END_HOUR=21
TIMEZONE=Asia/Jakarta

# ---- Database ----
DB_PATH=data/database.sqlite
